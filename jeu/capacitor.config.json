{
  "appId": "io.github.ppcrepin.elenchos",
  "appName": "Elenchos",
  "webDir": "public",
  "loggingBehavior": "none",
  "ios": {
    "path": "ios",
    "scheme": "App",
    "contentInset": "never",
    "allowsLinkPreview": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["banner", "list", "sound"]
    },
    "CapacitorHttp": {
      "enabled": false
    },
    "CapacitorCookies": {
      "enabled": false
    }
  }
}
