            "date": "2025-11-12",
            "extrait": "Chaque robot, c'est une camionnette de moins dans des rues déjà encombrées."
          }
        },
        {
          "id": "r3",
          "cote": "contre",
          "pole": 0,
          "texte": "Un trottoir doit rester sûr pour les enfants et les personnes âgées.",
          "depute": {
            "nom": "Chloé Inventée",
            "feminin": true,
            "groupe": "Groupe inventé des Charmes",
            "elision": "de"
          },
          "source": {
            "adresse": "https://www.assemblee-nationale.fr/dyn/99/comptes-rendus/seance-inventee-1",
            "date": "2025-11-12",
            "extrait": "Le trottoir doit rester un lieu sûr, d'abord pour les enfants et pour les personnes âgées."
          }
        },
        {
          "id": "r4",
          "cote": "contre",
          "pole": "aucun",
          "texte": "Les communes n'ont pas les moyens de contrôler ces engins.",
          "depute": {
            "nom": "Denis Exemple",
            "feminin": false,
            "groupe": "Groupe inventé des Frênes",
            "elision": "de"
          },
          "source": {
            "adresse": "https://www.assemblee-nationale.fr/dyn/99/comptes-rendus/seance-inventee-1",
            "date": "2025-11-12",
            "extrait": "Qui contrôlera ces engins ? Pas nos communes, qui n'en ont pas les moyens."
          }
        }
