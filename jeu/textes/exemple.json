        {
          "id": "r1",
          "cote": "pour",
          "pole": 1,
          "texte": "Une ville qui n'essaie rien prend du retard.",
          "depute": {
            "nom": "Alice Exemple",
            "feminin": true,
            "groupe": "Groupe inventé des Aulnes",
            "elision": "d'"
          },
          "source": {
            "adresse": "https://www.assemblee-nationale.fr/dyn/99/comptes-rendus/seance-inventee-1",
            "date": "2025-11-12",
            "extrait": "Une ville qui n'essaie rien, mes chers collègues, prend toujours du retard sur les autres."
          }
        },
        {
          "id": "r2",
          "cote": "pour",
          "pole": "aucun",
          "texte": "Moins de camionnettes, ce sont des rues moins encombrées.",
          "depute": {
            "nom": "Bruno Fictif",
            "feminin": false,
            "groupe": "Groupe inventé des Bouleaux",
            "elision": "de"
          },
          "source": {
